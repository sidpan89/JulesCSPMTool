# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

# Application Settings
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=your_super_secret_key_for_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (Postgres)
POSTGRES_SERVER=postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=aisecdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@postgres:5432/aisecdb

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=False
SCAN_RESULTS_BUCKET=scan-results

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------

# OpenAI API Key (optional)
# If not provided, AI features will use fallback templates.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe API Keys (optional)
# If not provided, billing features will be disabled.
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_ESSENTIAL_PLAN_ID=price_xxxxxxxxxxxxxx
STRIPE_GROWTH_PLAN_ID=price_xxxxxxxxxxxxxx
STRIPE_SCALE_PLAN_ID=price_xxxxxxxxxxxxxx
