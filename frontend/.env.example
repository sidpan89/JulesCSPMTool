# The URL of the backend API. This is used by the frontend to make API calls.
# In local development (using Docker Compose), this should point to the backend service.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# This is an example, and you should create a .env.local file to override this for your local setup.
# For example, you might have a different port or hostname.
